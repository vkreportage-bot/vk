# Site
NEXT_PUBLIC_SITE_URL=https://vk-one.fr
NEXT_PUBLIC_SITE_NAME=VK
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Single-admin authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# PostgreSQL / Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/vk?schema=public
DATABASE_URL=
DIRECT_URL=

# YouTube Data API v3 (optional: used only for metadata enrichment)
YOUTUBE_API_KEY=

# Media storage
# local = development only. Never use local media storage on Vercel.
# supabase = recommended in production for admin-uploaded media.
MEDIA_STORAGE=local
MAX_UPLOAD_MB=100

# Supabase Storage (required when MEDIA_STORAGE=supabase)
# Create a PUBLIC bucket, for example "media".
SUPABASE_URL=
# Server-only Supabase secret key (sb_secret_...).
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=media
