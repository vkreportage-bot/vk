# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=VK
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Single-admin authentication
ADMIN_EMAIL=admin@example.com
# Preferred in production: bcrypt hash generated with `npx bcryptjs-cli hash "your-password"` or equivalent.
ADMIN_PASSWORD_HASH=
# Legacy development fallback only. Leave empty in production when ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# PostgreSQL / Prisma
# Example: postgresql://USER:PASSWORD@HOST:5432/vk?schema=public
DATABASE_URL=

# YouTube Data API v3 (admin-only metadata enrichment)
YOUTUBE_API_KEY=

# Local media upload is intended for development only.
# In production, replace the local adapter in lib/media-storage.ts by R2/S3/Cloudinary.
MEDIA_STORAGE=local
MAX_UPLOAD_MB=100
